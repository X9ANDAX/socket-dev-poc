{
  "name": "socket-dev-poc",
  "version": "2.0.0",
  "description": "Comprehensive Socket.dev evaluation POC - Testing ALL detection capabilities",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/preinstall.js",
    "postinstall": "node scripts/postinstall.js",
    "start": "node index.js",
    "dev": "nodemon index.js",
    "test:network": "node test/network-test.js",
    "test:filesystem": "node test/fs-test.js",
    "test:shell": "node test/shell-test.js",
    "test:eval": "node test/eval-test.js",
    "test:all": "npm run test:network && npm run test:filesystem && npm run test:shell && npm run test:eval",
    "socket:scan": "socket npm audit",
    "socket:report": "socket report create",
    "socket:ci": "socket ci",
    "audit:npm": "npm audit --json > audit-results/npm-audit.json",
    "audit:socket": "socket npm audit --json > audit-results/socket-audit.json",
    "compare:audits": "node scripts/compare-audits.js",
    "docker:build": "docker build -f docker/Dockerfile -t socket-poc .",
    "docker:run": "docker run -p 3000:3000 socket-poc",
    "workspace:api": "npm run start --workspace=packages/api-server",
    "workspace:worker": "npm run start --workspace=packages/worker-service",
    "workspace:processor": "npm run start --workspace=packages/data-processor"
  },
  "keywords": [
    "socket.dev",
    "security",
    "supply-chain",
    "evaluation",
    "poc",
    "devsecops"
  ],
  "author": "Security Testing Team",
  "license": "MIT",
